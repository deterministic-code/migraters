<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>Deterministic.MigrateRunner</RootNamespace>
    <AssemblyName>MigrateCore</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Deterministic.Migraters</PackageId>
    <Version>0.0.1</Version>
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1812;CA1848;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MigrateRunner" />
    <InternalsVisibleTo Include="MigrateRunner.Tests" />
    <InternalsVisibleTo Include="MigrateRunner.ProviderTests" />
    <Compile Remove="MigrateRunner.ProviderTests/**" />
    <Content Remove="MigrateRunner.ProviderTests/**" />
    <None Remove="MigrateRunner.ProviderTests/**" />
    <InternalsVisibleTo Include="MigrateSqlite" />
    <InternalsVisibleTo Include="MigratePostgres" />
    <InternalsVisibleTo Include="MigrateMysql" />
    <InternalsVisibleTo Include="MigrateSqlServer" />
    <InternalsVisibleTo Include="MigrateOracle" />
    <Compile Remove="Program.cs" />
    <Compile Remove="MigrateRunner.Tests/**" />
    <Compile Remove="MigrateInit/**" />
    <Compile Remove="Providers/**" />
    <Compile Include="Providers/Sql/**/*.cs" />
    <Content Remove="MigrateRunner.Tests/**" />
    <Content Remove="MigrateInit/**" />
    <Content Remove="Providers/**" />
    <None Remove="MigrateRunner.Tests/**" />
    <None Remove="MigrateInit/**" />
    <None Remove="Providers/**" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="..\cli.yaml"
      Link="cli.yaml"
      CopyToOutputDirectory="PreserveNewest"
      Pack="true"
      PackageCopyToOutput="true"
      PackagePath="contentFiles/any/net10.0/cli.yaml"
    />
    <Content
      Include="..\shared\templates\sql\**\*.sql"
      Link="templates\sql\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Pack="true"
      PackageCopyToOutput="true"
      PackagePath="contentFiles/any/net10.0/templates/sql/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="..\shared\templates\help\*.txt"
      Link="templates\help\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Pack="true"
      PackageCopyToOutput="true"
      PackagePath="contentFiles/any/net10.0/templates/help/%(Filename)%(Extension)"
    />
    <Content
      Include="..\shared\templates\messages\**\*.txt"
      Link="templates\messages\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Pack="true"
      PackageCopyToOutput="true"
      PackagePath="contentFiles/any/net10.0/templates/messages/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="..\shared\templates\scaffold\*.sql"
      Link="templates\scaffold\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Pack="true"
      PackageCopyToOutput="true"
      PackagePath="contentFiles/any/net10.0/templates/scaffold/%(Filename)%(Extension)"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>
</Project>
