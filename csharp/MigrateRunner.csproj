<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>Deterministic.MigrateRunner</RootNamespace>
    <AssemblyName>MigrateRunner</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseAppHost>true</UseAppHost>
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1812;CA1848;CA2007</NoWarn>
  </PropertyGroup>

  <Import Project="dialects.props" Condition="Exists('dialects.props')" />

  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Remove="MigrateRunner.Tests/**" />
    <Compile Remove="MigrateInit/**" />
    <Compile Remove="Providers/**" />
  </ItemGroup>

  <PropertyGroup>
    <MigrateVerbNames>migrate-setup;migrate-up;migrate-down;migrate-create</MigrateVerbNames>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="MigrateRunner.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <Target Name="CopyMigrateCommandHosts" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_MigrateExeExt Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_MigrateExeExt>
    </PropertyGroup>
    <ItemGroup>
      <_MigrateVerb Include="$(MigrateVerbNames)" />
    </ItemGroup>
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName)$(_MigrateExeExt)"
      DestinationFiles="$(TargetDir)%(_MigrateVerb.Identity)$(_MigrateExeExt)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target Name="CopyMigrateCommandHostsOnPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_MigrateExeExt Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_MigrateExeExt>
    </PropertyGroup>
    <ItemGroup>
      <_MigrateVerb Include="$(MigrateVerbNames)" />
    </ItemGroup>
    <Copy
      SourceFiles="$(PublishDir)$(AssemblyName)$(_MigrateExeExt)"
      DestinationFiles="$(PublishDir)%(_MigrateVerb.Identity)$(_MigrateExeExt)"
      SkipUnchangedFiles="true"
    />
  </Target>
</Project>
