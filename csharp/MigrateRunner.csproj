<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>Deterministic.MigrateRunner</RootNamespace>
    <AssemblyName>MigrateRunner</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseAppHost>true</UseAppHost>
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1812;CA1848;CA2007</NoWarn>
  </PropertyGroup>

  <Import Project="dialects.props" Condition="Exists('dialects.props')" />
  <PropertyGroup>
    <DialectSqlite Condition="'$(DialectSqlite)' == ''">true</DialectSqlite>
    <DialectPostgres Condition="'$(DialectPostgres)' == ''">true</DialectPostgres>
    <DialectMysql Condition="'$(DialectMysql)' == ''">true</DialectMysql>
    <DialectSqlserver Condition="'$(DialectSqlserver)' == ''">true</DialectSqlserver>
    <DialectOracle Condition="'$(DialectOracle)' == ''">true</DialectOracle>
    <DefineConstants Condition="'$(DialectSqlite)' == 'true'">$(DefineConstants);DIALECT_SQLITE</DefineConstants>
    <DefineConstants Condition="'$(DialectPostgres)' == 'true'">$(DefineConstants);DIALECT_POSTGRES</DefineConstants>
    <DefineConstants Condition="'$(DialectMysql)' == 'true'">$(DefineConstants);DIALECT_MYSQL</DefineConstants>
    <DefineConstants Condition="'$(DialectSqlserver)' == 'true'">$(DefineConstants);DIALECT_SQLSERVER</DefineConstants>
    <DefineConstants Condition="'$(DialectOracle)' == 'true'">$(DefineConstants);DIALECT_ORACLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MigrateRunner.Tests" />
    <Compile Remove="MigrateRunner.Tests/**" />
    <Content Remove="MigrateRunner.Tests/**" />
    <None Remove="MigrateRunner.Tests/**" />
    <EmbeddedResource Remove="MigrateRunner.Tests/**" />
    <Compile Remove="MigrateInit/**" />
    <Content Remove="MigrateInit/**" />
    <None Remove="MigrateInit/**" />
    <EmbeddedResource Remove="MigrateInit/**" />
    <Compile Remove="Dialects/SqliteDialect.cs" Condition="'$(DialectSqlite)' != 'true'" />
    <Compile Remove="Dialects/PostgresDialect.cs" Condition="'$(DialectPostgres)' != 'true'" />
    <Compile Remove="Dialects/MysqlDialect.cs" Condition="'$(DialectMysql)' != 'true'" />
    <Compile Remove="Dialects/SqlServerDialect.cs" Condition="'$(DialectSqlserver)' != 'true'" />
    <Compile Remove="Dialects/OracleDialect.cs" Condition="'$(DialectOracle)' != 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <MigrateVerbNames>migrate-setup;migrate-up;migrate-down;migrate-create</MigrateVerbNames>
  </PropertyGroup>

  <ItemGroup>
    <Content
      Include="..\cli.yaml"
      Link="cli.yaml"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\shared\templates\sql\**\*.sql"
      Link="templates\sql\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\shared\templates\help\*.txt"
      Link="templates\help\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\shared\templates\messages\**\*.txt"
      Link="templates\messages\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\shared\templates\scaffold\*.sql"
      Link="templates\scaffold\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" Condition="'$(DialectSqlite)' == 'true'" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" Condition="'$(DialectSqlserver)' == 'true'" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.7.0" Condition="'$(DialectOracle)' == 'true'" />
    <PackageReference Include="Npgsql" Version="9.0.1" Condition="'$(DialectPostgres)' == 'true'" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" Condition="'$(DialectMysql)' == 'true'" />
  </ItemGroup>

  <Target Name="CopyMigrateCommandHosts" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_MigrateExeExt Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_MigrateExeExt>
    </PropertyGroup>
    <ItemGroup>
      <_MigrateVerb Include="$(MigrateVerbNames)" />
    </ItemGroup>
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName)$(_MigrateExeExt)"
      DestinationFiles="$(TargetDir)%(_MigrateVerb.Identity)$(_MigrateExeExt)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target Name="CopyMigrateCommandHostsOnPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_MigrateExeExt Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_MigrateExeExt>
    </PropertyGroup>
    <ItemGroup>
      <_MigrateVerb Include="$(MigrateVerbNames)" />
    </ItemGroup>
    <Copy
      SourceFiles="$(PublishDir)$(AssemblyName)$(_MigrateExeExt)"
      DestinationFiles="$(PublishDir)%(_MigrateVerb.Identity)$(_MigrateExeExt)"
      SkipUnchangedFiles="true"
    />
  </Target>
</Project>
