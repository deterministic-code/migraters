<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Deterministic.MigrateRunner</RootNamespace>
    <AssemblyName>MigrateSqlite</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Deterministic.Migraters.Sqlite</PackageId>
    <Version>0.0.1</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\MigrateRunner.Core.csproj" />
    <InternalsVisibleTo Include="MigrateRunner.Tests" />
    <InternalsVisibleTo Include="MigrateRunner.ProviderTests" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
