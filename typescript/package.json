{
  "name": "@deterministic-code/migraters",
  "version": "0.0.1",
  "description": "TypeScript migrate executables for deterministic-code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "migrate-up": "./dist/bin/migrate-up.js",
    "migrate-down": "./dist/bin/migrate-down.js",
    "migrate-setup": "./dist/bin/migrate-setup.js",
    "migrate-create": "./dist/bin/migrate-create.js",
    "migrate-init": "./dist/bin/migrate-init.js"
  },
  "files": [
    "dist",
    "src",
    "cli.yaml",
    "bundle.yaml",
    "tsconfig.build.json"
  ],
  "scripts": {
    "build": "rm -rf dist.tmp && tsc -p tsconfig.build.json --outDir dist.tmp && cp -R ../shared/templates dist.tmp/templates && cp ../cli.yaml dist.tmp/cli.yaml && rm -rf dist && mv dist.tmp dist",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "generate:help": "node --experimental-strip-types src/generate-help.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "mssql": "*",
    "mysql2": "*",
    "oracledb": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "*",
    "@types/mssql": "*",
    "@types/node": "^22.10.0",
    "@types/oracledb": "*",
    "@types/pg": "*",
    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "*",
    "mssql": "*",
    "mysql2": "*",
    "oracledb": "*",
    "pg": "*",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
