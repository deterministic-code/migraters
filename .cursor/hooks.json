{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/lock-imigrater.py"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/lock-imigrater.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/lock-imigrater.py",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/lock-imigrater.py"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "python3 .cursor/hooks/lock-imigrater.py"
      }
    ]
  }
}
