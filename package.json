{
  "name": "@deterministic-code/migraters",
  "version": "0.0.1",
  "private": true,
  "description": "Migrate executables for deterministic-code (typescript, rust, csharp).",
  "type": "module",
  "bin": {
    "migrate-init": "./typescript/dist/bin/migrate-init.js",
    "migrate-setup": "./typescript/dist/bin/migrate-setup.js",
    "migrate-up": "./typescript/dist/bin/migrate-up.js",
    "migrate-down": "./typescript/dist/bin/migrate-down.js",
    "migrate-create": "./typescript/dist/bin/migrate-create.js"
  },
  "files": [
    "typescript/dist",
    "/cli.yaml",
    "/bundle.yaml",
    "shared/templates"
  ],
  "scripts": {
    "prepare": "npm run build --prefix typescript",
    "build": "npm run build --prefix typescript",
    "typecheck": "npm run typecheck --prefix typescript",
    "test": "npm run test --prefix typescript && npm run test:rust && npm run test:csharp",
    "test:rust": "CARGO_TARGET_DIR=rust/target cargo llvm-cov --manifest-path rust/Cargo.toml --lib --fail-under-lines 100 --fail-under-functions 100 --fail-under-regions 100 --ignore-filename-regex 'src/(abstractions|argv|checksum|cli_spec|help|infrastructure|messages|migrater|migrations|provider)|lib\\.rs'",
    "test:csharp": "dotnet test csharp/MigrateRunner.Tests/MigrateRunner.Tests.csproj",
    "test:e2e": "docker compose -f proof/docker-compose.yml up -d --wait && bash proof/ensure-instant-client.sh && npm run test:e2e --prefix typescript",
    "generate:help": "npm run generate:help --prefix typescript",
    "format": "npm run format --prefix typescript"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/oracledb": "^6.10.3",
    "@types/pg": "^8.11.10",
    "mysql2": "^3.22.2",
    "typescript": "^5.8.0"
  }
}
